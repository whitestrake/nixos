name: "Update Packages"
on:
  workflow_dispatch:
    inputs:
      package:
        description: "Comma-separated packages to update (leave empty for all)"
        required: false
        type: string
  schedule:
    - cron: "0 12 * * *" # Daily at 12:00 UTC
permissions:
  contents: read
concurrency:
  group: update-packages
  queue: max
jobs:
  update-packages:
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
      - uses: ./.github/actions/install-nix
      - name: Run nix-update
        id: update
        run: |
          set -euo pipefail

          if [ -n "$PACKAGE" ]; then
            # shellcheck disable=SC2016
            PACKAGES="$(jq -cn --arg package "$PACKAGE" '$package | split(",") | map(gsub("^\\s+|\\s+$"; "")) | map(select(length > 0))')"
          else
            # shellcheck disable=SC2016
            PACKAGES="$(nix eval --json '.#updatablePackages' --accept-flake-config)"
          fi

          BODY="$RUNNER_TEMP/package-update-pr.md"
          cat > "$BODY" <<'EOF'
          Automated package updates via `nix-update`.

          | Package | Before | After |
          |---|---:|---:|
          EOF
          failures=()

          while IFS= read -r package; do
            before_diff="$(git diff | git hash-object --stdin)"

            if old_version="$(nix eval --raw ".#${package}.version" --accept-flake-config)" && \
              nix run nixpkgs#nix-update -- \
                --flake \
                --use-update-script \
                "$package" && \
              new_version="$(nix eval --raw ".#${package}.version" --accept-flake-config)"; then
              after_diff="$(git diff | git hash-object --stdin)"

              if [ "$before_diff" != "$after_diff" ]; then
                # shellcheck disable=SC2016
                printf '| `%s` | `%s` | `%s` |\n' \
                  "$package" "$old_version" "$new_version" >> "$BODY"
              fi
            else
              failures+=("$package")
              git restore --worktree -- "packages/$package.nix"
            fi
          done < <(jq -r '.[]' <<< "$PACKAGES")

          if ((${#failures[@]})); then
            echo "failed=true" >> "$GITHUB_OUTPUT"
            {
              echo
              echo "Failed updates:"
              # shellcheck disable=SC2016
              printf -- '- `%s`\n' "${failures[@]}"
            } >> "$BODY"
          fi

          if ! git diff --quiet; then
            echo "changed=true" >> "$GITHUB_OUTPUT"
            echo "body_path=$BODY" >> "$GITHUB_OUTPUT"
          fi
        env:
          PACKAGE: ${{ inputs.package }}
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
      - name: Format files
        if: steps.update.outputs.changed == 'true'
        run: nix fmt
      - name: Create GitHub App token
        id: app-token
        if: steps.update.outputs.changed == 'true'
        uses: actions/create-github-app-token@v3
        with:
          client-id: ${{ vars.WHITESTRAKE_BOT_APP_CLIENT_ID }}
          private-key: ${{ secrets.WHITESTRAKE_BOT_APP_PRIVATE_KEY }}
          permission-contents: write
          permission-pull-requests: write
      - name: Create Pull Request
        if: steps.update.outputs.changed == 'true'
        uses: peter-evans/create-pull-request@v8
        with:
          token: ${{ steps.app-token.outputs.token }}
          branch: nix-update/packages
          title: "chore(pkgs): update packages"
          body-path: ${{ steps.update.outputs.body_path }}
          labels: dependencies
          commit-message: "chore(pkgs): update packages"
          delete-branch: true
      - name: Report update failures
        if: always() && steps.update.outputs.failed == 'true'
        run: exit 1
