+type testVersionServer struct {
+	versionapi.UnimplementedVersionServer
+}
+
+func (s *testVersionServer) Version(ctx context.Context, _ *emptypb.Empty) (*versionapi.VersionResponse, error) {
+	namespace, _ := namespaces.Namespace(ctx)
+	return &versionapi.VersionResponse{Version: namespace}, nil
+}
+
+func TestClientCacheSeparatesNamespaces(t *testing.T) {
+	resetClientCacheForTest(t)
+	socketPath := startVersionServer(t)
+
+	mobyClient, err := Client(socketPath, "moby")
+	if err != nil {
+		t.Fatalf("Client(%q, moby) failed: %v", socketPath, err)
+	}
+	k8sClient, err := Client(socketPath, "k8s.io")
+	if err != nil {
+		t.Fatalf("Client(%q, k8s.io) failed: %v", socketPath, err)
+	}
+	if mobyClient == k8sClient {
+		t.Fatal("Client returned the same cached client for distinct namespaces")
+	}
+	assertVersion(t, mobyClient, "moby")
+	assertVersion(t, k8sClient, "k8s.io")
+}
+
+func TestClientCacheSeparatesAddresses(t *testing.T) {
+	resetClientCacheForTest(t)
+	firstSocket := startVersionServer(t)
+	secondSocket := startVersionServer(t)
+
+	firstClient, err := Client(firstSocket, "moby")
+	if err != nil {
+		t.Fatalf("Client(%q, moby) failed: %v", firstSocket, err)
+	}
+	secondClient, err := Client(secondSocket, "moby")
+	if err != nil {
+		t.Fatalf("Client(%q, moby) failed: %v", secondSocket, err)
+	}
+	if firstClient == secondClient {
+		t.Fatal("Client returned the same cached client for distinct addresses")
+	}
+}
+
+func TestClientCacheSerialisesSameKey(t *testing.T) {
+	resetClientCacheForTest(t)
+	socketPath := startVersionServer(t)
+
+	const callers = 32
+	clients := make([]ContainerdClient, callers)
+	errs := make([]error, callers)
+	var ready sync.WaitGroup
+	ready.Add(callers)
+	start := make(chan struct{})
+	var done sync.WaitGroup
+	done.Add(callers)
+	for i := range callers {
+		go func() {
+			defer done.Done()
+			ready.Done()
+			<-start
+			clients[i], errs[i] = Client(socketPath, "moby")
+		}()
+	}
+	ready.Wait()
+	close(start)
+	done.Wait()
+
+	for i := range callers {
+		if errs[i] != nil {
+			t.Fatalf("Client caller %d failed: %v", i, errs[i])
+		}
+		if clients[i] != clients[0] {
+			t.Fatalf("Client caller %d received a distinct client for the same key", i)
+		}
+	}
+}
+
+func assertVersion(t *testing.T, client ContainerdClient, want string) {
+	t.Helper()
+	got, err := client.Version(context.Background())
+	if err != nil {
+		t.Fatalf("Version() failed: %v", err)
+	}
+	if got != want {
+		t.Fatalf("Version() = %q, want %q", got, want)
+	}
+}
+
+func startVersionServer(t *testing.T) string {
+	t.Helper()
+	socketDir, err := os.MkdirTemp("/tmp", "cadvisor-containerd-")
+	if err != nil {
+		t.Fatalf("os.MkdirTemp failed: %v", err)
+	}
+	t.Cleanup(func() {
+		if err := os.RemoveAll(socketDir); err != nil {
+			t.Logf("failed to clean up socket dir %q: %v", socketDir, err)
+		}
+	})
+	socketPath := filepath.Join(socketDir, "containerd.sock")
+	listener, err := net.Listen("unix", socketPath)
+	if err != nil {
+		t.Fatalf("net.Listen(%q) failed: %v", socketPath, err)
+	}
+	server := grpc.NewServer()
+	versionapi.RegisterVersionServer(server, &testVersionServer{})
+	go func() {
+		if err := server.Serve(listener); err != nil {
+			t.Logf("test containerd server stopped: %v", err)
+		}
+	}()
+	t.Cleanup(server.Stop)
+	return socketPath
+}
+
+func resetClientCacheForTest(t *testing.T) {
+	t.Helper()
+
+	ctrdClientsMu.Lock()
+	previous := ctrdClients
+	ctrdClients = map[clientCacheKey]*cachedClient{}
+	ctrdClientsMu.Unlock()
+
+	t.Cleanup(func() {
+		ctrdClientsMu.Lock()
+		ctrdClients = previous
+		ctrdClientsMu.Unlock()
+	})
+}
